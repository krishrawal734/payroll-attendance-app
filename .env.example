# Supabase Cloud Database Configuration
# Get these values from: Supabase Dashboard -> Project Settings -> API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Company details printed on payslips and reports
EXPO_PUBLIC_COMPANY_NAME=
EXPO_PUBLIC_COMPANY_ADDRESS=
EXPO_PUBLIC_COMPANY_GSTIN=

# Static login OTP, 4-8 digits (put the real value in .env.local, which is gitignored)
EXPO_PUBLIC_STATIC_OTP=
