iv>\n      <div class="stat-label">Night Present (> 7 PM)</div>\n    </div>\n    <div class="stat-item">\n      <div class="stat-val" style="color: #d97706;">${t.leavesTaken}</div>\n      <div class="stat-label">Approved Leaves</div>\n    </div>\n  </div>\n\n  \x3c!-- Salary Calculations --\x3e\n  <table class="salary-table">\n    <thead>\n      <tr>\n        <th>Earnings & Allowances</th>\n        <th style="text-align: right;">Amount (\u20b9)</th>\n        <th>Deductions & Advances</th>\n        <th style="text-align: right;">Amount (\u20b9)</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>\n          <strong>Base Shift Earnings</strong><br>\n          <span style="font-size: 10px; color: #64748b;">${'daily'===e.salaryType?`${t.presentDays} days \xd7 \u20b9${e.baseSalary}`:'Monthly Pro-rated Salary'}</span>\n        </td>\n        <td style="text-align: right; font-weight: 700;">\u20b9${(t.grossEarnings-a).toLocaleString('en-IN')}</td>\n        <td>\n          <strong>Advance Recovery</strong><br>\n          <span style="font-size: 10px; color: #64748b;">Auto-deducted from Passbook Ledger</span>\n        </td>\n        <td style="text-align: right; color: #dc2626; font-weight: 700;">- \u20b9${t.advanceDeductions.toLocaleString('en-IN')}</td>\n      </tr>\n      <tr>\n        <td>\n          <strong>Night Shift Allowance</strong><br>\n          <span style="font-size: 10px; color: #7c3aed;">${t.nightPresentDays} night shifts \xd7 \u20b9250 bonus</span>\n        </td>\n        <td style="text-align: right; font-weight: 700; color: #7c3aed;">+ \u20b9${a.toLocaleString('en-IN')}</td>\n        <td>\n          <strong>Taxes & Other Statutory Deductions</strong><br>\n          <span style="font-size: 10px; color: #64748b;">TDS / PF (Zero for current slab)</span>\n        </td>\n        <td style="text-align: right; font-weight: 700;">\u20b90</td>\n      </tr>\n      <tr style="background-color: #f8fafc;">\n        <td><strong>TOTAL GROSS EARNINGS</st